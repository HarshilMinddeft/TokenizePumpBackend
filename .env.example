# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Frontend origin(s) allowed via CORS in production. Comma-separated for
# multiple origins, e.g.:
#   CLIENT_URL=http://localhost:5173,https://app.truefraction.io
CLIENT_URL=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=

# ─── Pinata / IPFS ────────────────────────────────────────────────────────────
PINATA_JWT=
GATEWAY_URL=

# ─── Blockchain ───────────────────────────────────────────────────────────────
RPC_URL=
PRIVATE_KEY=
# Sends registerIdentity — must hold AGENT rights on the IdentityRegistry.
DEPLOYER_PRIVATE_KEY=

# Sends IdFactory.createIdentity, which is onlyOwner — this account MUST be the
# IdFactory's owner. Leave blank to reuse DEPLOYER_PRIVATE_KEY.
ID_ISSUER_PRIVATE_KEY=

# Signs ERC-735 KYC claims. MUST be registered as a purpose-3 (CLAIM) key on the
# ClaimIssuer at CLAIM_ISSUER_ADDRESS, or claims fail isClaimValid and the user
# never verifies. Leave blank to reuse DEPLOYER_PRIVATE_KEY.
CLAIM_SIGNER_PRIVATE_KEY=

# ─── OnchainID / T-REX contracts ──────────────────────────────────────────────
# From the contracts repo:
#   ignition/deployments/infra-<chainId>/deployed_addresses.json
ID_FACTORY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
CLAIM_ISSUER_ADDRESS=

# ISO 3166-1 numeric country code recorded at registration. 784 = UAE.
DEFAULT_COUNTRY_CODE=

# ─── Blockpass KYC ────────────────────────────────────────────────────────────
BLOCKPASS_API_KEY=
BLOCKPASS_SERVICE_ID=

# ─── Rent distribution ────────────────────────────────────────────────────────
# Goldsky subgraph — use the `prod` tag URL so redeploys don't change it.
SUBGRAPH_URL=
# From the contracts repo's ignition/deployments/*/deployed_addresses.json
RENT_DISTRIBUTOR_ADDRESS=
FEE_MANAGER_ADDRESS=
MARKETPLACE_ADDRESS=
STABLECOIN_ADDRESS=

# Extra admin wallets (comma-separated). Wallets holding AUTHORITY_ROLE or
# DEFAULT_ADMIN_ROLE on the marketplace are admins without being listed here.
ADMIN_WALLET_ADDRESSES=
ADMIN_SESSION_TTL_HOURS=12

# TESTNET ONLY — allow distributing the month in progress (paid up to the
# subgraph's latest block). Keep false in production.
RENT_ALLOW_CURRENT_MONTH=false
# Read-only RPC for rent reads (must allow parallel requests and recent-block calls).
CHAIN_READ_RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
